{
  "name": "heydaystar-kakao-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx server/index.js\"",
    "dev:web": "vite",
    "dev:api": "tsx server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:verify": "prisma migrate deploy && tsx server/db/verifyPostgres.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.6",
    "pg": "^8.23.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html-to-image": "^1.11.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "jsdom": "^26.0.0",
    "oxlint": "^1.69.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vitest": "^5.0.0"
  }
}
