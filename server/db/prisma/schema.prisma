// Phase 0 scope only (docs/implementation_plan_v2.md §5.3, §20 Phase 0).
// Does NOT include the Relationship Engine's AnalysisResult/chunk-plan schema —
// that belongs to Phase 1 and is intentionally out of scope here.
//
// Dev DB: local Docker Postgres (docker-compose.yml). Raw conversation text is
// never modeled here — only quota counters and usage/cost metadata, matching
// the "원문 미저장" principle carried over from 1.0's server/quotaStore.js.

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
}

/// Mirrors the shape of the 1.0 server/data/quota.json record (server/quota.js),
/// just moved from a flat file to Postgres so it survives restarts/redeploys.
model DeviceQuota {
  deviceId    String   @id @map("device_id")
  /// KST calendar date string (e.g. "2026-09-12"). A row is treated as reset
  /// once the current KST date no longer matches this field (server/quota.js
  /// getDeviceRecord semantics, preserved as-is).
  date        String
  used        Int      @default(0)
  shareBonus  Int      @default(0) @map("share_bonus")
  /// Epoch ms of the last share-bonus grant, for the cooldown check.
  lastShareAt BigInt   @default(0) @map("last_share_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("device_quotas")
}

/// One row per LLM call site (analyze / OCR), capturing response.usage so
/// per-call cost is actually measurable (analysis_v1.md §4.8 — 1.0 had none
/// of this instrumentation).
model AnalysisUsageLog {
  id           String   @id @default(cuid())
  deviceId     String?  @map("device_id")
  /// "analyze" | "ocr_screenshots" — which existing 1.0 endpoint this call came from.
  callSite     String   @map("call_site")
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  /// Estimated USD cost for this single call, from the pricing table in
  /// server/db/pricing.ts. Not authoritative billing — a cost *estimate*.
  costEstimate Float    @map("cost_estimate")
  durationMs   Int      @map("duration_ms")
  success      Boolean
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("analysis_usage_logs")
}

/// Phase 2 (docs/implementation_plan_v2.md §5.3, §16.2). Only the Free
/// Preview (Stage 1) fields this phase actually produces are modeled here —
/// `paidFields`/`paidExpiresAt`/`paymentId` from §5.3's original combined
/// sketch are deliberately deferred to Phase 3 (added via a later migration,
/// once Paid Deep and payment actually exist) rather than created now as
/// unused nullable columns. `stage2Status` is kept from that sketch as a
/// forward-compatible placeholder — every row Phase 2 writes stays
/// NOT_STARTED — so Phase 3 only needs to ALTER TABLE, never rename this.
model AnalysisResult {
  id                String       @id @default(cuid())
  deviceId          String?      @map("device_id")
  intent            String
  analysisMode      AnalysisMode @map("analysis_mode")
  windowLabel       String       @map("window_label")
  /// Chunk ids the Preview stage already ran through the LLM (§16.1's "이미
  /// 수행한 분석을 중복 호출하지 않는다") — stored as JSON string[].
  processedChunkIds Json         @map("processed_chunk_ids")
  /// Serialized PreviewScoreResult + PreviewNarrative + topSignal
  /// (server/engine/pipeline/types.ts). Raw conversation text is never
  /// stored here or anywhere else (docs/prd_v2.md §25.1).
  previewFields     Json         @map("preview_fields")
  stage2Status      Stage2Status @default(NOT_STARTED) @map("stage2_status")
  /// §6.5: Free/Preview rows live at most 24h. findById() on the repository
  /// treats an expired row as not-found even before purgeExpired() physically
  /// deletes it.
  previewExpiresAt  DateTime     @map("preview_expires_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([previewExpiresAt])
  @@map("analysis_results")
}

enum Stage2Status {
  NOT_STARTED
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
}

enum AnalysisMode {
  SNAPSHOT
  STANDARD
  DEEP
}
