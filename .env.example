# Anthropic API 키 (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# ── Google AdSense (선택 — 없으면 광고 placeholder 표시) ──
# ads.txt용: ca-pub- 또는 pub- 로 시작해도 됨
# ADSENSE_PUBLISHER_ID=pub-1234567890123456

# 광고 스크립트·슬롯 (Vite 빌드 시 포함 — Render에서도 Build 시 필요)
# VITE_ADSENSE_CLIENT=ca-pub-1234567890123456
# VITE_ADSENSE_SLOT_BANNER=1234567890
# VITE_ADSENSE_SLOT_RECTANGLE=1234567890
# VITE_ADSENSE_SLOT_LEADERBOARD=1234567890

# 선택: 모델 변경 (기본 claude-sonnet-4-6 — 풍부한 분석)
# 더 빠른 분석이 필요하면 claude-haiku-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-6

# 선택: 스크린샷 OCR 전용 모델 (기본 claude-haiku-4-5)
# ANTHROPIC_OCR_MODEL=claude-haiku-4-5

# API 서버 포트 (기본 3001)
# PORT=3001

# ── 일일 사용량 제한 (기본 3회 + 공유 보너스 최대 3 = 하루 6회) ──
# 개발·테스트 시 제한 끄기: RATE_LIMIT_DISABLED=true
# RATE_LIMIT_DISABLED=true

# ── 2.0 Phase 0: 로컬 개발용 Postgres (docker-compose up -d 후 사용) ──
# 비어 있으면(설정 자체를 안 하면) quota/usage 로깅은 1.0의 파일 기반 저장을 그대로 사용한다.
# DATABASE_URL=postgresql://heydaystar:heydaystar_dev@localhost:5432/heydaystar_kakao_analyzer

# ── 2.0 Phase 0.5: DB 장애 시 파일 폴백 허용 여부 ──
# DATABASE_URL을 설정했는데 Postgres 연결이 실패하는 경우의 동작:
#   - production: 이 값과 무관하게 항상 에러(503)를 낸다. 파일로 조용히 폴백하지 않는다.
#   - 그 외 환경: 아래를 true로 설정해야만 파일로 폴백한다. 기본은 에러.
# ALLOW_FILE_DB_FALLBACK=true

# ── 2.0 Phase 0.5: CORS allowlist ──
# 콤마로 구분한 오리진 목록. 개발 환경에는 http://localhost:5173 이 항상 자동 포함된다.
# ALLOWED_ORIGINS=https://app.heydaystar.co.kr

# ── 2.0 Phase 2: Free Preview LLM 호출 오버라이드 (선택) ──
# 둘 다 비워두면 server/engine/signals/llmSignalExtractor.ts 자신의 기본값을
# 그대로 쓴다. 낮은 토큰 상한을 실측 없이 넣으면 구조화 출력 JSON이 중간에
# 잘리는 문제가 재현된다(docs/implementation_plan_v2.md §27.2-2 참고) — 벤치마크
# 없이 이 값들을 함부로 낮추지 말 것.
# ANTHROPIC_PREVIEW_MODEL=claude-sonnet-4-6
# ANTHROPIC_PREVIEW_MAX_OUTPUT_TOKENS=4096
